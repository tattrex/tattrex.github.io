{
  "name": "tattrex-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test simulation/tests/*.test.mjs tests/*.test.mjs",
    "test:browser": "node tests/site-browser.mjs && node tests/site-lifecycle.mjs",
    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.0"
  }
}
